# Internal planning, specs, audits and ICM workspace. Kept on disk, not published.
docs/

# Audio de apertura de cajas. Es una grabación del juego de Valve: sirve para uso
# personal en tu máquina, pero este repo es público y subirlo sería redistribuirla.
# El archivo vive local en public/sounds/ y el build de Electron lo empaqueta igual
# (build.extraResources ya copia public/). Si falta, el carrete usa los ticks sintetizados.
public/sounds/*.mp3

# Worktrees de Claude Code. Cada uno es una copia completa del repo, con su propio
# node_modules y su propio build .next. No es codigo del proyecto: es andamiaje de sesion.
.claude/worktrees/
.gstack/

# Documentos de desarrollo: instrucciones de agentes, compuertas y auditorias.
# Viven en disco para trabajar, no en el repo publico.
CLAUDE.md
GATES*.md
HELX_AUDIT.md

# Copia local de ByMykel/CSGO-API (catalogo de CS2, ~355 MB). No es de este proyecto:
# se clona aparte en csgo/. Solo se versionan los scripts propios de siembra.
csgo/*
!csgo/build-cases.js
!csgo/case-prices.json
!csgo/rarity.js
!csgo/rarity.test.ts
!csgo/seed-skin-prices.js
!csgo/seed-to-db.js

# Skills locales de agentes (QA, etc.). Herramienta de desarrollo, no se publica.
.claude/skills/
capturas/
